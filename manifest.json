{
  "key": "",
  "manifest_version": 3,
  "name": "국가유산 보고서 파일명 정리",
  "description": "국가유산 보고서 PDF를 참고문헌식 파일명으로 저장하고, 인용문 복사까지 돕습니다.",
  "version": "0.2.0",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.heritage.go.kr/*",
    "*://*.cha.go.kr/*",
    "*://*.khs.go.kr/*",
    "*://*.e-minwon.go.kr/*",
    "*://*.nrich.go.kr/*",
    "*://*.cihc.or.kr/*",
    "*://*.iha.go.kr/*",
    "http://116.67.83.213/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/book-16.png",
    "32": "icons/book-32.png",
    "48": "icons/book-48.png",
    "128": "icons/book-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.heritage.go.kr/*",
        "*://*.cha.go.kr/*",
        "*://*.khs.go.kr/*",
        "*://*.e-minwon.go.kr/*",
        "*://*.nrich.go.kr/*",
        "*://*.cihc.or.kr/*",
        "*://*.iha.go.kr/*"
      ],
      "js": [
        "src/site-policy.js",
        "src/constants.js",
        "src/filename.js",
        "src/page-extractors.js",
        "src/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "action": {
    "default_title": "국가유산 보고서 파일명 설정",
    "default_popup": "options/options.html?mode=popup",
    "default_icon": {
      "16": "icons/book-16.png",
      "32": "icons/book-32.png",
      "48": "icons/book-48.png",
      "128": "icons/book-128.png"
    }
  }
}
